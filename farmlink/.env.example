# Copy this file to .env and fill in real values. .env is gitignored.

APP_NAME=FarmLink
ENVIRONMENT=development

DATABASE_URL=postgresql+asyncpg://farmlink:farmlink_dev_password@db:5432/farmlink
REDIS_URL=redis://redis:6379/0

JWT_SECRET=replace-with-a-long-random-string
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Paystack ---
# Start with TEST keys (sk_test_..., pk_test_...) for all local/CI work.
# Live keys (sk_live_..., pk_live_...) are only ever set in the production
# environment's secret manager, never in this file or in git.
PAYSTACK_SECRET_KEY=sk_test_replace_me
PAYSTACK_PUBLIC_KEY=pk_test_replace_me

# --- Firestore (Day 11) ---
FIRESTORE_PROJECT_ID=
FIRESTORE_CREDENTIALS_PATH=
